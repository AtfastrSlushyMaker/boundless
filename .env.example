POSTGRES_DB=boundless
POSTGRES_USER=boundless
POSTGRES_PASSWORD=boundless_dev
POSTGRES_PORT=54329
DATABASE_URL=postgresql+asyncpg://boundless:boundless_dev@127.0.0.1:54329/boundless
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000
LLM_PROVIDER=mlx
LLM_BASE_URL=http://127.0.0.1:8088/v1
LLM_MODEL=lukey03/Qwen3.5-9B-abliterated-MLX-4bit
LLM_API_KEY=none
# Optional alternative to entering a DeepSeek key in Model settings:
DEEPSEEK_API_KEY=
LLM_TIMEOUT_SECONDS=240
LLM_CONTEXT_WINDOW=131072
LLM_MAX_OUTPUT_TOKENS=1200
LLM_TEMPERATURE=0.82
# Memory embeddings: hash (local, default), ollama, openai-compatible, or none.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
# Keep raw state-interpreter output in turn diagnostics (development only).
STATE_DEBUG=false

# Docker Compose runs the API in Linux, so its default model endpoint is Ollama
# on the host. Select DeepSeek or another provider in Model settings if preferred.
COMPOSE_LLM_PROVIDER=ollama
COMPOSE_LLM_BASE_URL=http://host.docker.internal:11434
COMPOSE_LLM_MODEL=qwen3.5:9b
# Set true only when Docker runs on an Apple Silicon Mac with an MLX server on the host.
HOST_MLX_SUPPORTED=false
MLX_HOST_BASE_URL=http://host.docker.internal:8088/v1
COMPOSE_MLX_LAUNCHER_BASE_URL=http://host.docker.internal:8091
